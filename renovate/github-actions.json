{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Automerge patch updates of shared workflow and preset references",
      "matchManagers": [
        "github-actions",
        "renovate-config"
      ],
      "matchDepNames": [
        "ekawijayasusilo/shared_workflow"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
